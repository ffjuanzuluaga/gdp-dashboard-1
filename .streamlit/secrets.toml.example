# Copia este archivo como .streamlit/secrets.toml para desarrollo local.
# En Streamlit Community Cloud NO subas este archivo: pega el contenido
# en App → Settings → Secrets.
# ⚠️ Agrega .streamlit/secrets.toml a tu .gitignore

[odoo]
url = "https://tu-instancia.odoo.com/odoo"      # sin slash final
db = "nombre-exacto-de-tu-base-de-datos"        # nombre exacto de la BD
username = "usuario@tudominio.com"
api_key = "tu-api-key-aqui"  # API Key, no la contraseña
